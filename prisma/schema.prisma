generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  PRODUCT_IMAGE
  PRODUCT_VIDEO
  REFERENCE_IMAGE
  REFERENCE_VIDEO
}

enum ComplianceStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
  PROVIDER_FAILED
}

enum JobType {
  ASSET_ANALYSIS
  SCRIPT_GENERATION
  VIDEO_GENERATION
  SHOT_REGENERATION
  EXPERIMENT_GENERATION
}

enum JobStatus {
  QUEUED
  RUNNING
  RETRYABLE
  FAILED
  COMPLETED
}

enum VideoAspectRatio {
  VERTICAL_9_16
  HORIZONTAL_16_9
}

enum ExperimentStatus {
  QUEUED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ComplianceObjectType {
  ASSET
  SCRIPT
  SHOT
  VIDEO_EXPORT
}

enum AudioAssetType {
  TTS
  BGM
}

enum AudioAssetStatus {
  READY
  FAILED
  FALLBACK
}

enum AnalyticsIngestionSource {
  MANUAL
  CSV
  MOCK
  EXTERNAL
}

enum AnalyticsIngestionStatus {
  RECEIVED
  VALIDATED
  IMPORTED
  FAILED
}

model Product {
  id             String          @id @default(cuid())
  title          String
  category       String
  sellingPoints  String[]
  audience       String
  scenario       String
  productUrl     String?
  language       String          @default("en-US")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assets         Asset[]
  scripts        Script[]
  generationJobs GenerationJob[]
  factorMetrics  FactorMetric[]
  experiments    VideoExperiment[]
}

model Asset {
  id               String           @id @default(cuid())
  productId        String?
  type             AssetType
  filename         String
  objectKey        String
  url              String
  thumbnailUrl     String?
  sourceStatement  String
  complianceStatus ComplianceStatus @default(PENDING)
  productTags      String[]
  videoSummary     String?
  embedding        Json?
  metadata         Json             @default("{}")
  createdAt        DateTime         @default(now())
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  slices           AssetSlice[]
  complianceReviews ComplianceReview[]
}

model AssetSlice {
  id          String   @id @default(cuid())
  assetId     String
  startMs     Int
  endMs       Int
  thumbnailUrl String?
  summary     String
  tags        String[]
  embedding   Json?
  isUsable    Boolean  @default(true)
  createdAt   DateTime @default(now())
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model FactorMetric {
  id          String   @id @default(cuid())
  productId   String?
  scriptId    String?
  exportId    String?
  factor      String
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  gmvCents    Int      @default(0)
  spendCents   Int      @default(0)
  watchSeconds Int      @default(0)
  channel      String?
  variantId    String?
  ingestionId  String?
  source      String   @default("mock")
  observedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      VideoVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  ingestion    AnalyticsIngestion? @relation(fields: [ingestionId], references: [id], onDelete: SetNull)
}

model CreativeTemplate {
  id          String   @id @default(cuid())
  name        String
  strategy    String
  factors     Json
  categories  String[]
  shotPattern Json
  createdAt   DateTime @default(now())
  scripts     Script[]
}

model Script {
  id             String           @id @default(cuid())
  productId      String
  templateId     String?
  title          String
  narrative      String
  visualStyle    String
  language       String
  constraints    String[]
  prompt         String
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  template       CreativeTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  shots          StoryboardShot[]
  exports        VideoExport[]
  complianceReviews ComplianceReview[]
  variants       VideoVariant[]
}

model StoryboardShot {
  id              String   @id @default(cuid())
  scriptId        String
  order           Int
  durationMs      Int
  visualPrompt    String
  cameraMotion    String
  materialQuery   String
  subtitle        String
  voiceover       String
  bgmMood         String
  selectedSliceId String?
  generatedUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  script          Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
}

model GenerationJob {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(QUEUED)
  progress    Int       @default(0)
  productId   String?
  scriptId    String?
  input       Json      @default("{}")
  output      Json      @default("{}")
  trace       Json      @default("[]")
  error       String?
  retryCount  Int       @default(0)
  experimentId String?
  variantId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  experiment  VideoExperiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  variant     VideoVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model VideoExport {
  id          String           @id @default(cuid())
  scriptId    String
  aspectRatio VideoAspectRatio
  resolution  String
  durationMs  Int
  fileUrl     String
  coverUrl    String?
  config      Json            @default("{}")
  variantId   String?
  createdAt   DateTime        @default(now())
  script      Script          @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  variant     VideoVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  complianceReviews ComplianceReview[]
}

model VideoExperiment {
  id          String           @id @default(cuid())
  productId   String
  goal        String
  status      ExperimentStatus @default(QUEUED)
  variantCount Int             @default(2)
  winnerVariantId String?
  config      Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants    VideoVariant[]
  jobs        GenerationJob[]
}

model VideoVariant {
  id            String           @id @default(cuid())
  experimentId  String
  productId     String
  scriptId      String?
  jobId         String?
  exportId      String?
  name          String
  factors       Json             @default("{}")
  metricSummary Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  experiment    VideoExperiment  @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  script        Script?          @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  metrics       FactorMetric[]
  generationJobs GenerationJob[]
  exports       VideoExport[]
}

model ComplianceReview {
  id          String               @id @default(cuid())
  objectType  ComplianceObjectType
  objectId    String
  status      ComplianceStatus     @default(PENDING)
  ruleHits    Json                 @default("[]")
  trace       Json                 @default("[]")
  reviewerNote String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  assetId     String?
  scriptId    String?
  exportId    String?
  asset       Asset?               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  script      Script?              @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  export      VideoExport?         @relation(fields: [exportId], references: [id], onDelete: Cascade)
}

model AudioAsset {
  id          String           @id @default(cuid())
  type        AudioAssetType
  language    String?
  mood        String?
  durationMs  Int
  fileUrl     String
  provider    String
  status      AudioAssetStatus @default(READY)
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())
}

model AnalyticsIngestion {
  id          String                    @id @default(cuid())
  source      AnalyticsIngestionSource
  status      AnalyticsIngestionStatus  @default(RECEIVED)
  filename    String?
  fieldMapping Json                     @default("{}")
  validation  Json                      @default("{}")
  rowsReceived Int                      @default(0)
  rowsImported Int                      @default(0)
  error       String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  metrics     FactorMetric[]
}
