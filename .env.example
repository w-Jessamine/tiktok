# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
WEB_PORT=5173
PUBLIC_API_BASE_URL=http://localhost:4000

# Ark / Volcengine Fangzhou. Keep real values in .env or deployment secrets only.
AI_PROVIDER=hybrid
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_TEXT_MODEL=
ARK_VIDEO_MODEL=
ARK_EMBEDDING_MODEL=
ARK_VIDEO_MAX_POLLS=12
ARK_VIDEO_POLL_INTERVAL_MS=5000
ARK_VIDEO_DEBUG_SAMPLE=false
TTS_PROVIDER=mock
BGM_PROVIDER=mock
COMPLIANCE_PROVIDER=rules
ANALYTICS_PROVIDER=manual

DATABASE_URL=postgresql://videopilot:videopilot@localhost:5432/videopilot?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=videopilot
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

LOCAL_PUBLIC_STORAGE_URL=/storage
